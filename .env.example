# === REQUIRED: external API keys ===
GROQ_API_KEY=your_groq_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# === Weaviate (self-hosted, no key needed) ===
WEAVIATE_URL=http://weaviate:8080

# === Neo4j (self-hosted) ===
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=researchos123

# === Ollama (self-hosted): embeddings, and optionally the generator + figure descriptions ===
OLLAMA_URL=http://ollama:11434
EMBED_MODEL=nomic-embed-text
# nomic-embed-text wants these task prefixes; for bge-* use EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: " and an empty EMBED_DOC_PREFIX
EMBED_QUERY_PREFIX=search_query:
EMBED_DOC_PREFIX=search_document:

# === Generator / concept extraction / claim verification (Llama-3) ===
# "groq" = hosted Llama-3 (default). "ollama" = local Llama-3.1-8B as in the report:
#   docker compose exec ollama ollama pull llama3.1:8b   then set LLM_PROVIDER=ollama
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
OLLAMA_LLM_MODEL=llama3.1:8b
GENERATION_TEMPERATURE=0

# === Figure descriptions with a vision-language model (optional; off by default) ===
# VLM_PROVIDER=ollama
# VLM_MODEL=qwen2.5vl:7b

# === Whisper ===
WHISPER_MODEL=base

# === Module 1: ingestion (Section 4.2 initial values) ===
CHUNK_SIZE=300
CHUNK_OVERLAP_RATIO=0.15
CONCEPT_EXTRACTION=true

# === Module 2: retrieval ===
RETRIEVAL_TOP_K=20
SEED_K=10
FUSION=alpha
RRF_K=60
EDGE_TRAVERSE_MIN=0.3
EXPLORE_PROB=0.05

# === Module 3: reranker feedback and self-pruning ===
COHERE_RERANK_MODEL=rerank-v3.5
RELEVANCE_CUTOFF=0.3
CONTEXT_SIZE=5
EDGE_LR=0.1
PRUNE_MIN_VISITS=5
PRUNE_BELOW=0.2
ALPHA_INIT=0.5
ALPHA_RATE=0.05
ALPHA_MIN=0.2
ALPHA_MAX=0.9
FEEDBACK_ENABLED=true

# === Module 4: grounded generation ===
VERIFY_CLAIMS=true
VERIFY_MODE=flag

# === Module 5: evaluation judge (only for `python -m eval`; must differ from the generator) ===
# JUDGE_PROVIDER=openai          # or anthropic
# JUDGE_MODEL=
# JUDGE_API_KEY=
# JUDGE_BASE_URL=
# JUDGE_MODEL_DATE=

# === Backend ===
BACKEND_PORT=8000
FIGURES_DIR=/app/figures
