# === REQUIRED ===
GROQ_API_KEY=your_groq_api_key_here
NEO4J_PASSWORD=change_me

# === Qdrant (self-hosted locally, no key needed; set QDRANT_API_KEY for Qdrant Cloud) ===
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# === Neo4j ===
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# === Groq ===
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# === Retrieval ===
RERANK_TOP_N=5
RETRIEVAL_TOP_K=10
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# === Backend ===
FIGURES_DIR=/app/figures
# Comma-separated list of origins allowed to call the API directly (CORS).
# Not needed for the local docker-compose stack (frontend talks to the
# backend via the nginx /api proxy, so it's same-origin) -- only matters
# when the frontend and backend are on different origins, e.g. Vercel + HF Space.
ALLOWED_ORIGINS=http://localhost:3000
